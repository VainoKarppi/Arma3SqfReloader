{
    // Recommended workspace settings for developing this repository. This project's SqfReloader
    // settings live in .vscode/sqfReloader-settings.json.

    // The SqfReloader mod sources live in SqfReloaderExtension/@SqfReloader (mod.cpp, logo.paa,
    // addons/scripts) and are packed into scripts.pbo; open them there to edit SqfReloader's own
    // SQF functions.
    "files.associations": {
        "*.sqf": "sqf",
        "*.ext": "sqf",
        "*/$PBOPREFIX$": "plaintext",
        "*.cpp": "cpp",
        "*.hpp": "cpp"
    },
    "files.encoding": "utf8",
    "files.eol": "\r\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "[sqf]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[cpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/out": true,
        "**/SqfReloaderExtension/bin": true,
        "**/SqfReloaderExtension/obj": true,
        "**/SqfReloaderExtension/dist": true
    },
    "files.watcherExclude": {
        "**/SqfReloaderExtension/bin/**": true,
        "**/SqfReloaderExtension/obj/**": true,
        "**/SqfReloaderExtension/dist/**": true,
        "**/node_modules/**": true
    },
    "typescript.tsdk": "node_modules/typescript/lib",
    "chat.tools.terminal.autoApprove": {
        "/^npx tsc --noEmit -p tsconfig\\.json$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}
