arma3-sqf-reloader-*.vsix
*.bak
build-all.ps1
node_modules/**
out/**/*.map
src/**
scripts/**
tsconfig.json
.gitignore
.vscodeignore
.armaapi-links.json
.vscode/**
**/*.tsbuildinfo