{
  "name": "arma3-sqf-reloader",
  "displayName": "Arma 3 SQF Reloader",
  "description": "Hot-reloads SQF functions in a running Arma 3 (or Eden Editor) through the SqfReloader REST API. Creates mod junctions automatically.",
  "version": "3.7.5",
  "publisher": "Razer",
  "icon": "sqfReloader_logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/VainoKarppi/Arma3SqfReloader.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:sqfReloader.projectView",
    "onStartupFinished",
    "onCommand:sqfReloader.createExample",
    "workspaceContains:**/*.sqf",
    "workspaceContains:**/addons/**"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqfReloader",
          "title": "Arma 3",
          "icon": "media/arma.svg"
        }
      ]
    },
    "views": {
      "sqfReloader": [
        {
          "id": "sqfReloader.projectView",
          "name": "Arma Project",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "sqfReloader.play",
        "title": "SqfReloader: Play (start Arma 3 with this mod)",
        "icon": "$(play)"
      },
      {
        "command": "sqfReloader.stop",
        "title": "SqfReloader: Stop Arma 3"
      },
      {
        "command": "sqfReloader.setup",
        "title": "SqfReloader: Set up this mod (junction + config)",
        "icon": "$(plug)"
      },
      {
        "command": "sqfReloader.setupWorkspace",
        "title": "SqfReloader: Set up all mods in this workspace"
      },
      {
        "command": "sqfReloader.createExample",
        "title": "SqfReloader: Create example mod (try the reloader)"
      },
      {
        "command": "sqfReloader.connect",
        "title": "SqfReloader: Check connection"
      },
      {
        "command": "sqfReloader.reloadAll",
        "title": "SqfReloader: Reload all functions"
      },
      {
        "command": "sqfReloader.reloadRestartMission",
        "title": "SqfReloader: Reload and restart mission functions"
      },
      {
        "command": "sqfReloader.reloadFile",
        "title": "SqfReloader: Reload current function"
      },
      {
        "command": "sqfReloader.runFile",
        "title": "SqfReloader: Run in Arma"
      },
      {
        "command": "sqfReloader.runFileWithParameters",
        "title": "SqfReloader: Run in Arma With Parameters"
      },
      {
        "command": "sqfReloader.openInEden",
        "title": "SqfReloader: Open in Eden"
      },
      {
        "command": "sqfReloader.hostMission",
        "title": "SqfReloader: Launch as non-dedicated server with this mission"
      },
      {
        "command": "sqfReloader.startDedicatedServer",
        "title": "SqfReloader: Start dedicated server (server.cfg)"
      },
      {
        "command": "sqfReloader.stopDedicatedServer",
        "title": "SqfReloader: Stop dedicated server"
      },
      {
        "command": "sqfReloader.setClientMod",
        "title": "Arma 3: Set folder as Client Mod"
      },
      {
        "command": "sqfReloader.setServerMod",
        "title": "Arma 3: Set folder as Server Mod"
      },
      {
        "command": "sqfReloader.setSharedMod",
        "title": "Arma 3: Set folder as Shared Mod"
      },
      {
        "command": "sqfReloader.clearModType",
        "title": "Arma 3: Clear Mod Type"
      },
      {
        "command": "sqfReloader.removeJunctions",
        "title": "SqfReloader: Remove junctions created by this extension"
      },
      {
        "command": "sqfReloader.openArmaFolder",
        "title": "SqfReloader: Open Arma 3 folder"
      },
      {
        "command": "sqfReloader.showOutput",
        "title": "SqfReloader: Show output"
      },
      {
        "command": "sqfReloader.toggleAutoReload",
        "title": "SqfReloader: Toggle reload on save"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sqfReloader.startDedicatedServer"
        },
        {
          "command": "sqfReloader.openInEden",
          "when": "resourceExtname == .sqm"
        },
        {
          "command": "sqfReloader.reloadFile",
          "when": "resourceExtname == .sqf"
        },
        {
          "command": "sqfReloader.reloadRestartMission"
        },
        {
          "command": "sqfReloader.runFile",
          "when": "resourceExtname == .sqf"
        },
        {
          "command": "sqfReloader.runFileWithParameters",
          "when": "resourceExtname == .sqf"
        }
      ],
      "editor/context": [
        {
          "command": "sqfReloader.startDedicatedServer",
          "when": "resourceExtname == .cfg",
          "group": "sqfReloader@1"
        },
        {
          "command": "sqfReloader.openInEden",
          "when": "resourceExtname == .sqm",
          "group": "sqfReloader@1"
        },
        {
          "command": "sqfReloader.reloadFile",
          "when": "resourceExtname == .sqf",
          "group": "sqfReloader@1"
        },
        {
          "command": "sqfReloader.runFile",
          "when": "resourceExtname == .sqf",
          "group": "sqfReloader@2"
        },
        {
          "command": "sqfReloader.runFileWithParameters",
          "when": "resourceExtname == .sqf",
          "group": "sqfReloader@2"
        }
      ],
      "explorer/context": [
        {
          "command": "sqfReloader.startDedicatedServer",
          "when": "resourceExtname == .cfg",
          "group": "sqfReloader@1"
        },
        {
          "command": "sqfReloader.openInEden",
          "when": "resourceExtname == .sqm",
          "group": "sqfReloader@1"
        },
        {
          "command": "sqfReloader.runFile",
          "when": "resourceExtname == .sqf",
          "group": "sqfReloader@1"
        },
        {
          "command": "sqfReloader.runFileWithParameters",
          "when": "resourceExtname == .sqf",
          "group": "sqfReloader@1"
        },
        {
          "command": "sqfReloader.setup",
          "when": "explorerResourceIsFolder",
          "group": "sqfReloader@1"
        },
        {
          "command": "sqfReloader.setClientMod",
          "when": "explorerResourceIsFolder",
          "group": "sqfReloader@2"
        },
        {
          "command": "sqfReloader.setServerMod",
          "when": "explorerResourceIsFolder",
          "group": "sqfReloader@2"
        },
        {
          "command": "sqfReloader.setSharedMod",
          "when": "explorerResourceIsFolder",
          "group": "sqfReloader@2"
        },
        {
          "command": "sqfReloader.clearModType",
          "when": "explorerResourceIsFolder",
          "group": "sqfReloader@2"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".vscode/sqfReloader-settings.json",
        "url": "./schemas/sqfReloader-settings.schema.json"
      }
    ],
    "configuration": {
      "title": "Arma 3 SQF Reloader",
      "properties": {
        "sqfReloader.arma3ToolsDirectory": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional global Arma 3 Tools install directory (or full path to AddonBuilder.exe). When set, this path is used instead of registry discovery."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
